{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PostToolUse": [
			{
				"hooks": [
					{
						"command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/lintOnEdit.ts\"",
						"type": "command"
					}
				],
				"matcher": "Edit|Write"
			}
		],
		"PreToolUse": [
			{
				"hooks": [
					{
						"command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/guardBash.ts\"",
						"type": "command"
					}
				],
				"matcher": "Bash"
			},
			{
				"hooks": [
					{
						"command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/guardEdit.ts\"",
						"type": "command"
					}
				],
				"matcher": "Edit|Write"
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(scripts/env.sh status)",
			"Bash(yarn verify)",
			"Bash(yarn health:*)",
			"Bash(yarn lint:*)",
			"Bash(yarn plan:*)",
			"Bash(yarn test:*)"
		],
		"deny": [
			"Read(./.env)"
		]
	}
}
